// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  studio   Studio?
  media    Media[]
  albums   Album[]
  packages Package[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  impersonatedBy String? @map("impersonated_by")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  accountId  String @map("account_id")
  providerId String @map("provider_id")

  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  idToken String? @map("id_token")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── Public site ─────────────────────────────────────────────────────────────
// Every model below is tenant-scoped by `photographerId` (the owning User).

enum SiteTemplate {
  MINIMAL
  EDITORIAL
  BOLD

  @@map("site_template")
}

enum FontPair {
  MODERN
  CLASSIC
  ELEGANT

  @@map("font_pair")
}

enum ThemeMode {
  LIGHT
  DARK
  BOTH

  @@map("theme_mode")
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

model Studio {
  id             String       @id @default(cuid())
  photographerId String       @unique @map("photographer_id")
  slug           String       @unique
  name           String
  tagline        String?
  bio            String?
  email          String?
  phone          String?
  city           String?
  country        String?
  /// { instagram?, facebook?, youtube?, vimeo?, tiktok?, website? }
  socials        Json         @default("{}")
  logoMediaId    String?      @map("logo_media_id")
  coverMediaId   String?      @map("cover_media_id")
  template       SiteTemplate @default(MINIMAL)
  accentColor    String       @default("#c8a96e") @map("accent_color")
  fontPair       FontPair     @default(MODERN) @map("font_pair")
  /// LIGHT / DARK forces one palette; BOTH follows the visitor (with a toggle).
  themeMode      ThemeMode    @default(BOTH) @map("theme_mode")
  /// Languages the public site is offered in (subset of the app locales).
  locales        String[]     @default(["en"])
  defaultLocale  String       @default("en") @map("default_locale")
  published      Boolean      @default(false)
  bookingEnabled Boolean      @default(true) @map("booking_enabled")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  photographer User   @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  logo         Media? @relation("StudioLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  cover        Media? @relation("StudioCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@map("studios")
}

model Media {
  id             String    @id @default(cuid())
  photographerId String    @map("photographer_id")
  type           MediaType
  /// Object key in the R2 bucket: `{photographerId}/{cuid}.{ext}`
  key            String    @unique
  filename       String
  mimeType       String    @map("mime_type")
  size           Int
  width          Int?
  height         Int?
  durationSec    Float?    @map("duration_sec")
  alt            String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  photographer  User        @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  albumItems    AlbumItem[]
  studioLogos   Studio[]    @relation("StudioLogo")
  studioCovers  Studio[]    @relation("StudioCover")
  albumCovers   Album[]     @relation("AlbumCover")
  packageCovers Package[]   @relation("PackageCover")

  @@index([photographerId, createdAt])
  @@map("media")
}

model Album {
  id             String   @id @default(cuid())
  photographerId String   @map("photographer_id")
  title          String
  slug           String
  description    String?
  coverMediaId   String?  @map("cover_media_id")
  position       Int      @default(0)
  published      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  photographer User        @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  cover        Media?      @relation("AlbumCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  items        AlbumItem[]

  @@unique([photographerId, slug])
  @@index([photographerId, position])
  @@map("albums")
}

model AlbumItem {
  albumId  String @map("album_id")
  mediaId  String @map("media_id")
  position Int    @default(0)

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([albumId, mediaId])
  @@index([albumId, position])
  @@map("album_items")
}

model Package {
  id              String   @id @default(cuid())
  photographerId  String   @map("photographer_id")
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("TND")
  durationMinutes Int?     @map("duration_minutes")
  deliverables    String[] @default([])
  coverMediaId    String?  @map("cover_media_id")
  position        Int      @default(0)
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  photographer User   @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  cover        Media? @relation("PackageCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([photographerId, position])
  @@map("packages")
}
